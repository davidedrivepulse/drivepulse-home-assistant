  "config": {
    "step": {
      "user": {
        "title": "Add DrivePulse",
        "description": "This creates a private address (a webhook) that the DrivePulse app sends your car's data to. No account, no cloud: the data stays in your Home Assistant. Select Submit, then paste the address into the app."
      }
    },
    "create_entry": {
      "default": "DrivePulse is ready. In the app open “Send to Home Assistant”, paste this address in “Webhook address” and tap “Test send”:\n\n{webhook_url}\n\nAway from home, use the HTTPS address of your Home Assistant (for example Nabu Casa) or a VPN, and turn off “Local network only” in the integration options."
    }
  },
